<UserControl x:Class="SpeechProcessing.Views.UserControl_SpeechToText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpeechProcessing.Views"
             xmlns:vm="clr-namespace:SpeechProcessing.ViewModels"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:styles="clr-namespace:SpeechProcessing.Styles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:UserControl_SpeechToText_ViewModels x:Name="viewModel" />
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border CornerRadius="10" BorderThickness="1" Margin="5,5,5,5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6D2FFF" Offset="0"/>
                    <GradientStop Color="#FB539B" Offset="0.5"/>
                    <GradientStop Color="#836EFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="5" Text="Speech To Text" VerticalAlignment="Center" FontSize="50" FontWeight="Medium" Foreground="Wheat"></TextBlock>
                <Border CornerRadius="5" Margin="5,25,0,25">
                    <Button x:Name="btnGuide"
                        Style="{StaticResource controlButton}"
                        Tag="{StaticResource color4 }"
                        Click="btnGuide_Click">
                    
                        <fa:IconImage Icon="Question" Height="30" Width="30" Style="{StaticResource controlButtonIcon}"/>
                    
                    </Button>
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="gridMain">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10" BorderThickness="1" Margin="5,5,5,5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D2FFF" Offset="0"/>
                        <GradientStop Color="#FB539B" Offset="0.5"/>
                        <GradientStop Color="#836EFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel>
                    <Label Margin="5,0,0,0" Content="Speech file" FontSize="20" Foreground="{StaticResource color1}"/>
                    <Border Background="#F4E7F8" CornerRadius="10" BorderThickness="1" Margin="10,10,10,10">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D2FFF" Offset="0"/>
                                <GradientStop Color="#FB539B" Offset="0.5"/>
                                <GradientStop Color="#836EFB" Offset="1"/>
                            </LinearGradientBrush>

                        </Border.BorderBrush>
                        <Grid Margin="10" Background="#F4E7F8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Background="#F4E7F8" Tag="LoadSTT">
                                <TextBlock Text="{Binding InputFolder}" TextWrapping="WrapWithOverflow" />
                                <TextBlock
                        Foreground="{Binding ColorLoading}"
                        Text="{Binding ExceptionLoading}"
                        TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                            <Button
                    Grid.Column="1"
                    Background="#F4E7F8"
                    HorizontalAlignment="Center"
                    Tag="LoadSTT"
                    Click="Button_LoadData_Click"
                    Content="Browse"
                    FontSize="14"
                    Style="{StaticResource myButtonStyle}" 
                    IsEnabled="{Binding ButtonFlag}"/>

                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" Margin="5,5,5,5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D2FFF" Offset="0"/>
                        <GradientStop Color="#FB539B" Offset="0.5"/>
                        <GradientStop Color="#836EFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Border Height="50" Background="#F4E7F8" CornerRadius="10" BorderThickness="1" Margin="10,10,10,10">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6D2FFF" Offset="0"/>
                            <GradientStop Color="#FB539B" Offset="0.5"/>
                            <GradientStop Color="#836EFB" Offset="1"/>
                        </LinearGradientBrush>

                    </Border.BorderBrush>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnPause" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed" Style="{StaticResource buttonStylePlayPause}" Click="btnPause_Click" IsEnabled="{Binding ButtonFlag}">
                            <fa:IconImage Icon="Pause" Margin="10"/>
                        </Button>
                        <Button x:Name="btnPlay"  Background="Transparent" BorderBrush="Transparent" Style="{StaticResource buttonStylePlayPause}" Click="btnPlay_Click" IsEnabled="{Binding ButtonFlag}">
                            <fa:IconImage Icon="Play" Margin="10"/>
                        </Button>
                        <TextBlock Grid.Column="1" Name="StatusLbl" FontSize="14" VerticalAlignment="Center" Margin="10,0" MinWidth="60" TextAlignment="Center">00:00:00</TextBlock>
                        <Slider Margin="5,0,10,0" Grid.Column="2" Name="ProgressSlider" Maximum="1" Thumb.DragStarted="ProgressSlider_DragStarted" Thumb.DragCompleted="ProgressSlider_DragCompleted" ValueChanged="ProgressSlider_ValueChanged" VerticalAlignment="Center"/>
                    </Grid>
                </Border>


            </Border>
            <Button
                Width="250"
                Grid.Row="2"
                Background="#F4E7F8"
                Foreground="Black"
                HorizontalAlignment="Center"
                Click="Button_Processing_Click"
                Content="{Binding ProcessButton}"
                FontSize="25"
                Style="{StaticResource myButtonStyle}" 
                IsEnabled="{Binding ProcessFlag}"/> 
            <Border Grid.Row="3" CornerRadius="10" BorderThickness="1" Margin="5,5,5,5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D2FFF" Offset="0"/>
                        <GradientStop Color="#FB539B" Offset="0.5"/>
                        <GradientStop Color="#836EFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border Background="#F4E7F8" CornerRadius="10" BorderThickness="1" Margin="10,10,10,10">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6D2FFF" Offset="0"/>
                            <GradientStop Color="#FB539B" Offset="0.5"/>
                            <GradientStop Color="#836EFB" Offset="1"/>
                        </LinearGradientBrush>

                    </Border.BorderBrush>
                    <TextBlock TextWrapping="Wrap" Text="{Binding TextPredict}" Margin="10">

                    </TextBlock>
                </Border>
            </Border>
        </Grid>
        
        <Border
            x:Name="borderProcessBarDotStyle"
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="10"
            Padding="30,10,30,10"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="20"
            Focusable="False"
            Visibility="Collapsed"> 
            <styles:ProcessBarDotStyle x:Name="processBarDotStyle" Focusable="False" />
        </Border>
    </Grid>
</UserControl>
