<UserControl x:Class="SpeechProcessing.Styles.ProcessBarDotStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpeechProcessing.Styles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Storyboard RepeatBehavior="Forever" x:Key="mystoryboard" Name="hello" >
            <DoubleAnimation Storyboard.TargetName="dotProgress1" BeginTime="0:0:1" Storyboard.TargetProperty="Opacity" From="0" To="1"/>
            <DoubleAnimation Storyboard.TargetName="dotProgress2" BeginTime="0:0:2" Storyboard.TargetProperty="Opacity" From="0" To="1"/>
            <DoubleAnimation Storyboard.TargetName="dotProgress3" BeginTime="0:0:3" Storyboard.TargetProperty="Opacity" From="0" To="1"/>
            <DoubleAnimation Storyboard.TargetName="dotProgress1" BeginTime="0:0:4" Storyboard.TargetProperty="Opacity" From="1" To="0"/>
            <DoubleAnimation Storyboard.TargetName="dotProgress2" BeginTime="0:0:5" Storyboard.TargetProperty="Opacity" From="1" To="0"/>
            <DoubleAnimation Storyboard.TargetName="dotProgress3" BeginTime="0:0:6" Storyboard.TargetProperty="Opacity" From="1" To="0"/>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center">
        <TextBlock Name="textBlockMessage" Text="Message" TextWrapping="WrapWithOverflow" Margin="5" TextAlignment="Center" FontSize="18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-40,0,0">
            <Label Name="dotProgress1" Content="." FontSize="50" FontWeight="Bold" VerticalContentAlignment="Top" Opacity="0"/>
            <Label Name="dotProgress2" Content="." FontSize="50" FontWeight="Bold" VerticalContentAlignment="Top" Opacity="0"/>
            <Label Name="dotProgress3" Content="." FontSize="50" FontWeight="Bold" VerticalContentAlignment="Top" Opacity="0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
